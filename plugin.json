{
  "name": "mockup-gallery",
  "version": "0.4.0",
  "description": "Design review gallery for HTML mockups — rate, select, save, track implementation",
  "commands": {
    "mockup-feedback": {
      "description": "Pull latest ratings, comments, and selections from the mockup gallery",
      "file": "commands/mockup-feedback.md"
    },
    "mockup-memories": {
      "description": "Show global and project-specific design memories, or promote learnings",
      "file": "commands/mockup-memories.md"
    },
    "mockup-gallery:sync": {
      "description": "Check alignment between COMMON.md, CLAUDE.md, and AGENTS.md",
      "file": "commands/mockup-sync.md"
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-shared-feedback.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-after-mockup-edit.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-pending.mjs\""
          }
        ]
      }
    ]
  }
}
