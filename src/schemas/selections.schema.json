{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MockupSelections",
  "type": "object",
  "required": ["exported", "total", "rated", "selections"],
  "properties": {
    "exported": { "type": "string", "format": "date-time" },
    "total": { "type": "integer", "minimum": 0 },
    "rated": { "type": "integer", "minimum": 0 },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "name", "rating"],
        "properties": {
          "file": { "type": "string" },
          "name": { "type": "string" },
          "rating": { "type": "string", "enum": ["unrated", "yay", "nay"] },
          "note": { "type": ["string", "null"] },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "rating"],
              "properties": {
                "name": { "type": "string" },
                "rating": { "type": "string", "enum": ["unrated", "yay", "nay"] },
                "note": { "type": ["string", "null"] }
              }
            },
            "default": []
          }
        }
      }
    }
  },
  "additionalProperties": false
}
