{
  "name": "mockup-gallery",
  "version": "0.5.2",
  "description": "Mockup review scatters across screenshots and chat, so the design you approved loses its reasoning before anyone builds it. Mockup Gallery runs a local review gallery that rates mockups and assigns them to routes it detects in your project, then writes every decision and its implementation contract to disk. Your coding agent builds what you actually approved. Start with /mockup-gallery.",
  "type": "module",
  "bin": {
    "mockup-gallery": "server/gallery-server.mjs"
  },
  "scripts": {
    "start": "node server/gallery-server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "mockup",
    "design",
    "review",
    "gallery",
    "claude-code",
    "plugin",
    "codex"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Tyrone Ross, Jr",
    "email": "46267523+tyroneross@users.noreply.github.com"
  },
  "homepage": "https://github.com/tyroneross/mockup-gallery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyroneross/mockup-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/tyroneross/mockup-gallery/issues"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "commands/",
    "gallery/",
    "hooks/",
    "memories/",
    "server/",
    "skills/",
    "src/",
    "sync/",
    "CLAUDE.md",
    "COMMON.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
