registry.json
node_modules/

# Never commit accidental project data into the plugin repo.
# The plugin is meant to operate on OTHER projects; these paths
# exist only as a safety net if the PROJECT_ROOT self-guard is
# bypassed somehow (e.g. someone passes --project pointing here).
# Root-anchored (leading slash) so legitimate fixtures under
# test/fixtures/<name>/mockups/ and test/fixtures/<name>/.mockup-gallery/
# are NOT ignored.
/mockups/
/.mockup-gallery/
/.atomize-gallery/

# Explicit un-ignore for test fixtures. Required because user's global
# gitignore (~/.config/git/ignore) may have an unanchored .mockup-gallery/
# pattern that would otherwise catch these legitimate fixture files. The
# leading `!` overrides the global ignore.
!test/fixtures/**/.mockup-gallery/
!test/fixtures/**/.mockup-gallery/**
!test/fixtures/**/mockups/
!test/fixtures/**/mockups/**

# Build-loop scratch directories (self-test workspaces)
/.build-loop/tmp/
